# Karriereseite ZAHN & GUT – Regeln für All-Inkl. Die Übergangsadresse (kasserver.com) bleibt immer erreichbar.
RewriteEngine On
RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
RewriteRule ^ - [L]

# http → https, mit www → ohne www (die alte Seite lief ebenfalls ohne www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.karriere-zahnundgut\.de$ [NC]
RewriteRule ^ https://karriere-zahnundgut.de%{REQUEST_URI} [L,R=301,NE]

# Alte Adressen der WordPress-Seite (Stand 07.10.2026) dauerhaft auf die neuen umleiten, Liste in doku/alte-adressen.md
RewriteRule ^job/ausbildung-als-zfa-zahnmedizinische-fachangestellte-m-w-d-2026/?$ /stellen/ausbildung-zfa-meerbusch.html [L,R=301]
RewriteRule ^job/zfa-zahnmedizinische-fachangestellte-zahnarzthelferin-als-behandlungsassistenz-m-w-d/?$ /stellen/zfa-behandlungsassistenz-meerbusch.html [L,R=301]
RewriteRule ^job/zmp-zmf-dh-zahnmedizinische-prophylaxeassistentin-dentalhygienikerin-m-w-d/?$ /stellen/zmp-zmf-dh-prophylaxe-meerbusch.html [L,R=301]
RewriteRule ^job/zmv-praxismanagerin-m-w-d-zahnmedizinische-verwaltungsangestellte-fuer-praxisorganisation-abrechnung/?$ /stellen/zmv-praxismanagerin-meerbusch.html [L,R=301]
RewriteRule ^job(/.*)?$ /#stellen [L,R=301,NE]
RewriteRule ^impressum/?$ /rechtliches/impressum.html [L,R=301]
RewriteRule ^datenschutzerklaerung/?$ /rechtliches/datenschutz.html [L,R=301]
RewriteRule ^(wp-admin|wp-login\.php|wp-content|feed)(/.*)?$ / [L,R=301]

# Konfiguration nie ausliefern
<Files "bewerbung-konfiguration.php">
  Require all denied
</Files>

# Zwischenspeicher: HTML nie, CSS/JS einen Tag, Bilder ein Jahr
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /404.html
